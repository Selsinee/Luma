{
  "expo": {
    "name": "Luma",
    "slug": "luma",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logogram.png",
    "scheme": "luma",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.theron.luma",
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.theron.luma",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logogram.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logogram.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logogram.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "googleClientId": {
        "ios": "353307199525-o5nkdqsl0678dv9vlikmdgij5k0vup3s.apps.googleusercontent.com",
        "android": "353307199525-te4lg5pb7kikclo0ldqmehbncd8lni92.apps.googleusercontent.com",
        "web": "353307199525-p525k1f1v9r4pgq57qcudcatd7ratd2a.apps.googleusercontent.com"
      },
      "router": {},
      "eas": {
        "projectId": "f4141a81-ff95-4e97-a8f3-cb17935eaac1"
      }
    }
  }
}
